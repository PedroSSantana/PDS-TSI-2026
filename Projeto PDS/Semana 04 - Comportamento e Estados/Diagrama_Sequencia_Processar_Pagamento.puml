@startuml
title FluxPay — Sequência: Processar Pagamento
autonumber
actor Pagador
boundary "Checkout Web" as Checkout
control "PagamentoController" as Controller
control "PagamentoService" as Service
entity "RepositorioCobranca" as RepoC
entity "RepositorioTransacao" as RepoT
participant "ProcessadorPagamento\n(Simulador)" as Processador
participant "ComprovanteService" as Comprovantes

Pagador -> Checkout: abrirLink(link)
Checkout -> Controller: carregarCheckout(idCobranca)
Controller -> RepoC: buscarPorId(idCobranca)
RepoC --> Controller: cobranca
Controller --> Checkout: dadosDaCobranca(cobranca)
Checkout --> Pagador: exibirValorEDescricao()

Pagador -> Checkout: selecionarMetodoEConfirmar(metodo)
Checkout -> Controller: pagar(idCobranca, metodo, dadosFicticios)
Controller -> Service: processarPagamento(cobranca, metodo)
Service -> Service: validarCobrancaAberta(cobranca)
Service -> Service: validarDadosDeTeste()
Service -> RepoT: salvar(novaTransacao)
RepoT --> Service: transacaoRegistrada
Service -> Processador: processar(transacao)

alt Resultado aprovado
  Processador --> Service: resultado(APROVADA, codigo)
  Service -> Service: registrarResultado(transacao, resultado)
  Service -> RepoT: salvar(transacaoAtualizada)
  Service -> RepoC: salvar(cobrancaAtualizada)
  Service -> Comprovantes: emitir(transacao)
  Comprovantes --> Service: comprovante
  Service --> Controller: pagamentoAprovado(comprovante)
  Controller --> Checkout: mostrarAprovacao(comprovante)
  Checkout --> Pagador: exibirConfirmacaoEComprovante()
else Resultado recusado
  Processador --> Service: resultado(RECUSADA, codigo)
  Service -> Service: registrarResultado(transacao, resultado)
  Service -> RepoT: salvar(transacaoAtualizada)
  Service --> Controller: pagamentoRecusado()
  Controller --> Checkout: mostrarRecusa()
  Checkout --> Pagador: exibirMensagemDeRecusa()
else Resultado pendente
  Processador --> Service: resultado(PENDENTE, codigo)
  Service -> Service: registrarResultado(transacao, resultado)
  Service -> RepoT: salvar(transacaoAtualizada)
  Service --> Controller: pagamentoPendente()
  Controller --> Checkout: mostrarPendencia()
  Checkout --> Pagador: exibirStatusEmProcessamento()
else Falha técnica
  Processador --> Service: indisponibilidade()
  Service -> Service: registrarResultado(transacao, FALHA_TECNICA)
  Service -> RepoT: salvar(transacaoAtualizada)
  Service --> Controller: erroDeProcessamento()
  Controller --> Checkout: mostrarFalhaTemporaria()
  Checkout --> Pagador: exibirOrientacaoParaNovaTentativa()
end
@enduml
