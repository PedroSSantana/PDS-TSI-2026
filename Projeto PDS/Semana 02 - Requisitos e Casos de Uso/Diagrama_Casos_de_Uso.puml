@startuml
title FluxPay — Diagrama de Casos de Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Comerciante" as Comerciante
actor "Pagador" as Pagador
actor "Processador de Pagamentos\n(Simulador)" as Processador

rectangle "FluxPay — Gateway de Pagamentos" {
  usecase "Autenticar-se" as UC01
  usecase "Criar cobrança" as UC02
  usecase "Validar dados\nda cobrança" as UC03
  usecase "Gerar link\nde pagamento" as UC04
  usecase "Consultar cobranças\ne transações" as UC05
  usecase "Visualizar detalhes\nda cobrança" as UC06
  usecase "Acessar checkout" as UC07
  usecase "Realizar pagamento" as UC08
  usecase "Validar cobrança\ne valor" as UC09
  usecase "Solicitar processamento" as UC10
  usecase "Registrar resultado" as UC11
  usecase "Visualizar comprovante" as UC12
  usecase "Cancelar cobrança" as UC13
}

Comerciante --> UC01
Comerciante --> UC02
Comerciante --> UC05
Comerciante --> UC06
Comerciante --> UC12
Comerciante --> UC13

Pagador --> UC07
Pagador --> UC08
Pagador --> UC12

Processador --> UC10

UC02 ..> UC01 : <<include>>
UC02 ..> UC03 : <<include>>
UC02 ..> UC04 : <<include>>
UC05 ..> UC01 : <<include>>
UC06 ..> UC01 : <<include>>
UC13 ..> UC01 : <<include>>
UC08 ..> UC09 : <<include>>
UC08 ..> UC10 : <<include>>
UC10 ..> UC11 : <<include>>
UC12 ..> UC08 : <<extend>>\n[pagamento aprovado]

@enduml
