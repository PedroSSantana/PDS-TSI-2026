@startuml
skinparam object {
    BackgroundColor White
    BorderColor #8B4513
    ArrowColor #A0522D
}

' Objetos
object "<u>:Gerente</u>" as gerente
object "<u>:TelaGerente</u>" as tela
object "<u>:ControladorProduto</u>" as controle
object "<u>:Produto</u>" as produto

' Links e mensagens
gerente -right-> tela : 1: selecionarProduto(codigo) >
tela -down-> controle : 1.1: localizarProduto(codigo) >
controle -right-> produto : 1.1.1: consultarProduto() >
produto -up-> tela : 1.1.2: exibirDadosProduto() >
gerente -down-> tela : 2: confirmarRemocao() >
tela -down-> controle : 2.1: removerProduto(produto) >
controle -right-> gerente : 2.1.1: removerProduto(produto) >
gerente -right-> produto : 2.1.2: desativar() >
tela -left-> gerente : 2.2: exibirConfirmacaoRemocao() >

@enduml
